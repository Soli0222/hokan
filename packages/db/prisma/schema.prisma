generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  generatedFileExtension = "mts"
  importFileExtension    = "mts"
  moduleFormat           = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ItemCategory {
  pc_peripheral
  network
  audio
  appliance
  game
  hobby
  furniture
  vehicle
  books_media
  digital
  other
}

enum AcquisitionType {
  purchase
  gift
  prize
  other
}

enum ItemCondition {
  new
  used
}

enum ItemStatus {
  owned
  disposed
}

enum NecessityTier {
  essential
  main
  sub
  dormant
}

enum DisposalMethod {
  sale
  trade_in
  discard
  transfer
  donation
  loss
}

enum DisposalReason {
  unused
  replaced
  broken
  not_needed
  cash
  other
}

enum ValuationLiquidity {
  high
  medium
  low
}

enum ValuationEstimatedBy {
  owner
  ai
}

model Item {
  id                      String           @id @default(uuid()) @db.Uuid
  name                    String           @db.VarChar(200)
  category                ItemCategory
  maker                   String?          @db.VarChar(200)
  model                   String?          @db.VarChar(200)
  acquiredOn              DateTime?        @map("acquired_on") @db.Date
  acquiredOnApprox        Boolean          @default(false) @map("acquired_on_approx")
  acquisitionType         AcquisitionType? @map("acquisition_type")
  purchasePrice           Int?             @map("purchase_price")
  purchaseSource          String?          @map("purchase_source") @db.VarChar(200)
  conditionAtAcquisition  ItemCondition?   @map("condition_at_acquisition")
  quantity                Int              @default(1)
  purpose                 String?
  location                String?          @db.VarChar(200)
  status                  ItemStatus       @default(owned)
  necessityTier           NecessityTier?   @map("necessity_tier")
  lastConfirmedOn         DateTime?        @map("last_confirmed_on") @db.Date
  notes                   String?
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  disposal                Disposal?
  valuations              Valuation[]

  @@map("items")
}

model Disposal {
  id         String          @id @default(uuid()) @db.Uuid
  itemId     String          @unique @map("item_id") @db.Uuid
  disposedOn DateTime        @map("disposed_on") @db.Date
  method     DisposalMethod
  amount     Int?
  channel    String?         @db.VarChar(200)
  reason     DisposalReason?
  notes      String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  item       Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("disposals")
}

model Valuation {
  id                   String               @id @default(uuid()) @db.Uuid
  itemId               String               @map("item_id") @db.Uuid
  estimatedResalePrice Int                  @map("estimated_resale_price")
  estimatedOn          DateTime             @map("estimated_on") @db.Date
  liquidity            ValuationLiquidity?
  source               String?              @db.VarChar(200)
  estimatedBy          ValuationEstimatedBy @default(owner) @map("estimated_by")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  item                 Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("valuations")
}

model AuthSession {
  id            String   @id @default(uuid()) @db.Uuid
  tokenHash     String   @unique @map("token_hash")
  issuer        String   @default("") @map("issuer") @db.VarChar(255)
  subject       String   @map("subject") @db.VarChar(255)
  email         String?  @map("email") @db.VarChar(255)
  emailVerified Boolean  @default(false) @map("email_verified")
  userAgent     String?  @map("user_agent") @db.VarChar(255)
  expiresAt     DateTime @map("expires_at")
  maxExpiresAt  DateTime @map("max_expires_at")
  lastUsedAt    DateTime @default(now()) @map("last_used_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("auth_sessions")
}

model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(100)
  tokenHash  String    @unique @map("token_hash")
  readOnly   Boolean   @default(false) @map("read_only")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("api_tokens")
}
